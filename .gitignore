# Built artefacts: the zips are produced by build.sh from the sources here.
dist/

# Promo media. The scripts that make these are kept; the output is not —
# it is tens of megabytes that regenerate in a minute.
promo/*.mp4
promo/*.wav
promo/av/
promo/cards/
promo/shots/
promo/posts.json
promo/first-frame-*.png

# Local only
.DS_Store
node_modules/
__pycache__/

# Foundry dependencies: installed with `forge install`, never vendored here.
vault/lib/

# Internal pre-publish notes for the predeploy check.
.predeploy-allow
